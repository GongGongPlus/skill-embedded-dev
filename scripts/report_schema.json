{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "embedded-dev completion report",
  "description": "Documentation contract for the completion report validated by `embedded_dev.py report`. The validator in scripts/embedded_dev.py is authoritative; this file keeps the contract reviewable without reading Python.",
  "type": "object",
  "required": ["schema_version", "summary", "changes", "evidence", "commands", "risks", "next_step"],
  "properties": {
    "schema_version": {"const": 1},
    "summary": {"type": "string", "minLength": 1},
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["claim", "level"],
        "properties": {
          "claim": {"type": "string", "minLength": 1},
          "level": {
            "enum": ["已确认", "工程推论", "估算", "待验证", "数据不足", "confirmed", "inferred", "estimate", "pending", "insufficient"]
          },
          "how": {"type": "string"}
        }
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["command"],
        "properties": {
          "command": {"type": "string", "minLength": 1},
          "result": {"type": "string"}
        }
      }
    },
    "risks": {"type": "array", "items": {"type": "string"}},
    "next_step": {"type": "string", "minLength": 1}
  }
}
